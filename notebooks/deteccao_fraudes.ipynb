import pandas as pd


# URL pública do dataset de transações financeiras
URL_DATASET = (
    "https://storage.googleapis.com/"
    "download.tensorflow.org/data/creditcard.csv"
)


def carregar_dados():
    """
    Carrega o dataset de transações financeiras diretamente da URL.

    Retorna:
        pandas.DataFrame: DataFrame com as transações.
    """
    df = pd.read_csv(URL_DATASET)
    return df


def visualizar_dados(df):
    """
    Exibe informações iniciais sobre o dataset.
    """
    print("\nPrimeiras cinco linhas:")
    print(df.head())

    print("\nQuantidade de linhas e colunas:")
    print(df.shape)

    print("\nNomes das colunas:")
    print(df.columns.tolist())

    print("\nTipos de dados:")
    print(df.dtypes)


def main():
    """
    Função principal da pipeline.
    """
    print("Iniciando carregamento do dataset...")

    df = carregar_dados()

    print("Dataset carregado com sucesso!")

    visualizar_dados(df)


if __name__ == "__main__":
    main()
